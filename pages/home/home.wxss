.home-page {
  /* 底部预留浮动语录按钮空间,避免遮挡楼层列表 */
  padding: 32rpx 24rpx calc(190rpx + env(safe-area-inset-bottom));
}
.home-heading { display: flex; align-items: flex-start; justify-content: space-between; padding: 0 8rpx 28rpx; }
.heading-copy { display: flex; flex-direction: column; gap: 6rpx; }
.page-kicker { font-size: 24rpx; color: var(--color-primary); font-weight: 600; }
.greeting { font-size: 30rpx; color: var(--text-primary); font-weight: 600; }
.privacy-badge { display: flex; align-items: center; gap: 6rpx; margin-top: 6rpx; padding: 6rpx 14rpx; border: 1rpx solid var(--border-color); border-radius: var(--radius-round); font-size: 20rpx; color: var(--text-secondary); background: var(--bg-card); }

.reserve-hero { padding: 36rpx 32rpx 32rpx; background: var(--bg-card); border-radius: 24rpx; }
.hero-copy { display: flex; flex-direction: column; }
.hero-title { font-size: 42rpx; color: var(--text-primary); line-height: 1.4; font-weight: 600; letter-spacing: 1rpx; }
.hero-description { margin-top: 14rpx; color: var(--text-secondary); font-size: 26rpx; }
.hero-meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8rpx; margin: 32rpx 0 24rpx; font-size: 22rpx; color: var(--text-secondary); }
.reserve-cta { display: flex; align-items: center; justify-content: space-between; background: var(--color-primary); color: #FFFFFF; font-size: 30rpx; font-weight: 600; padding: 22rpx 28rpx; line-height: 1.5; border-radius: 18rpx; text-align: left; }
.reserve-cta::after, .quick-action::after, .floor-row::after { border: 0; }
.reserve-cta-active { background: var(--color-primary-dark); }

/* ── 实时座位统计面板 ── */
.seat-stats { margin-top: 16rpx; padding: 28rpx 28rpx 24rpx; background: var(--bg-card); border-radius: 24rpx; }
.stats-head { display: flex; align-items: baseline; justify-content: space-between; padding: 0 4rpx 20rpx; }
.section-name { font-size: 30rpx; font-weight: 600; color: var(--text-primary); }
.stats-updated { font-size: 20rpx; color: var(--text-secondary); }
.stats-board { display: flex; align-items: stretch; gap: 24rpx; }
.stats-main { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
.stats-main-label { font-size: 22rpx; color: var(--text-secondary); }
.stats-main-value { margin-top: 6rpx; font-size: 84rpx; font-weight: 600; line-height: 1.1; color: var(--text-primary); letter-spacing: 2rpx; }
.stats-main-value--pop { animation: stats-pop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1); }
.stats-main-note { margin-top: 10rpx; font-size: 22rpx; color: var(--text-secondary); }
.stats-side { display: flex; flex-direction: column; justify-content: center; gap: 12rpx; }
.stats-cell { display: flex; flex-direction: column; align-items: flex-end; padding: 14rpx 20rpx; background: var(--color-primary-light); border-radius: 16rpx; min-width: 148rpx; }
.stats-cell--alt { background: var(--color-warning-light); }
.stats-cell-value-row { display: flex; align-items: baseline; }
.stats-cell-value { font-size: 40rpx; font-weight: 600; color: var(--text-primary); line-height: 1.2; }
.stats-cell-unit { margin-left: 4rpx; font-size: 24rpx; color: var(--text-primary); font-weight: 600; }
.stats-cell-label { margin-top: 4rpx; font-size: 20rpx; color: var(--text-secondary); }
.usage-track { margin-top: 22rpx; height: 16rpx; background: var(--color-primary-light); border-radius: var(--radius-round); overflow: hidden; }
.usage-fill { height: 100%; border-radius: var(--radius-round); transition: width 0.6s ease; }
.usage-fill--low { background: var(--color-success); }
.usage-fill--mid { background: var(--color-warning); }
.usage-fill--high { background: var(--color-danger); }

.quick-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.quick-action { display: flex; align-items: center; justify-content: space-between; flex: 1; min-width: 0; margin: 0; padding: 24rpx 20rpx; border-radius: 24rpx; background: var(--bg-card); line-height: 1.5; text-align: left; }
.quick-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; padding-right: 12rpx; }
.quick-title { color: var(--text-primary); font-size: 28rpx; font-weight: 600; }
.quick-description { color: var(--text-secondary); font-size: 22rpx; margin-top: 8rpx; }
.action-active { background: var(--bg-hover); }
.notice-row { display: flex; align-items: center; gap: 12rpx; padding: 24rpx 8rpx 8rpx; }
.notice-copy { flex: 1; min-width: 0; color: var(--text-secondary); font-size: 22rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.floor-section { margin-top: 32rpx; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; padding: 0 8rpx 20rpx; }
.section-note { font-size: 22rpx; color: var(--text-secondary); }
.floor-list { padding: 0 24rpx; background: var(--bg-card); border-radius: 24rpx; }
.floor-row { display: flex; align-items: center; gap: 24rpx; margin: 0; padding: 30rpx 0; background: transparent; border-radius: 0; text-align: left; line-height: 1.5; }
.floor-row + .floor-row { border-top: 1rpx solid var(--border-color); }
.floor-number { display: flex; align-items: baseline; justify-content: center; min-width: 68rpx; color: var(--color-primary); font-size: 40rpx; font-weight: 500; }
.floor-letter { font-size: 22rpx; margin-left: 4rpx; }
.floor-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.floor-title { font-size: 28rpx; color: var(--text-primary); font-weight: 500; }
.floor-description { font-size: 23rpx; color: var(--text-secondary); margin-top: 8rpx; }

@keyframes stats-pop {
  0%   { transform: scale(1); }
  50%  { transform: scale(1.16); }
  100% { transform: scale(1); }
}
.stats-retry { margin-top: 16rpx; padding: 8rpx 16rpx; font-size: 24rpx; line-height: 1.5; color: var(--color-primary); background: var(--color-primary-light); border-radius: 8rpx; }
.stats-retry::after { border: 1rpx solid var(--border-color); }
