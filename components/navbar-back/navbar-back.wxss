/* components/navbar-back/navbar-back.wxss */
.navbar-back-wrap {
  position: fixed;
  top: var(--navbar-top, 20rpx);
  left: 16rpx;
  z-index: 999;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.navbar-back-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.navbar-back-arrow {
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
  line-height: 1;
  margin-top: -6rpx;
}