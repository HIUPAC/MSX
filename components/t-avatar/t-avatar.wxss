.t-avatar { display:inline-flex; align-items:center; justify-content:center; overflow:hidden; border-radius:24rpx; background:#EAF0EB; color:#2F6B55; }
.t-avatar--small { width:48rpx; height:48rpx; border-radius:14rpx; }
.t-avatar--medium { width:80rpx; height:80rpx; border-radius:20rpx; }
.t-avatar--large { width:112rpx; height:112rpx; }
.t-avatar--xlarge { width:144rpx; height:144rpx; border-radius:32rpx; }
.t-avatar__image { width:100%; height:100%; }
.t-avatar__icon { display:flex; align-items:center; justify-content:center; line-height:1; }
